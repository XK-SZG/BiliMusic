# BiliMusic 配置文件
# 修改配置后需要重启应用才能生效

# 服务器配置
server:
  host: "127.0.0.1"  # 后端服务监听地址，建议保持 127.0.0.1（仅本地访问）
  port: 12180        # 后端服务端口，可根据需要修改（建议范围：10000-65535）
  debug: false       # 是否启用调试模式（生产环境请设置为 false）

# 存储配置
storage:
  download_path: "backend/data/downloads"  # 视频缓存目录
  cache_limit_gb: 10                       # 缓存上限 (GB)，超过后自动清理旧文件

# 调度器配置
scheduler:
  cleanup_interval_hours: 6  # 自动清理间隔（小时）

# 下载配置
download:
  max_workers: 3              # 并发下载线程数
  max_retries: 3              # 下载失败最大重试次数
  keep_failed_files: true     # 失败时把未完成的残留文件移入 data/failed_downloads 隔离区

# 日志配置
logging:
  level: "DEBUG"              # 根日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
  console: true               # 是否同时输出到控制台（Electron 主进程日志）
  file_enabled: true          # 是否写入物理日志文件
  memory_capacity: 20000      # 界面可查看的内存日志条数上限
  max_file_mb: 5              # 单个日志文件的体积上限 (MB)，写满后自动轮转
  max_files: 5                # 保留的日志文件数量上限，超出后删除最旧的归档
  max_total_mb: 25            # 日志目录的总占用上限 (MB)，超出后按最旧优先回收

# 数据库配置
database:
  pool_size: 20               # 连接池大小
  max_overflow: 40            # 最大溢出连接数
  pool_timeout: 10            # 获取连接超时（秒）
  pool_recycle: 1800          # 连接回收时间（秒）